# SMTP credentials for the contact + quote form mailer.
# Copy this file to .env.local and fill in real values. Restart `next dev` after changes.

# Hostname of the SMTP server (e.g. smtp.gmail.com, smtp.sendgrid.net, smtp.zoho.in)
SMTP_HOST=

# SMTP port. 587 for STARTTLS (most common), 465 for implicit TLS.
SMTP_PORT=587

# SMTP login (usually the full email address of the sending account)
SMTP_USER=

# SMTP password or app-specific password / API key
SMTP_PASS=

# (Optional) From-address shown to recipients. Defaults to SMTP_USER if unset.
SMTP_FROM=

# Inbox that should receive contact + quote submissions.
CONTACT_TO=

# (Optional) CC address(es) for submissions. Comma-separated for multiple.
CONTACT_CC=

# Google Apps Script Web App URL that appends form submissions to a Google Sheet.
SHEET_WEBHOOK_URL=
# Shared secret verified by the Apps Script so only your app can write rows.
SHEET_WEBHOOK_SECRET=

# Google reCAPTCHA v3 keys (spam/bot protection on the contact + quote forms).
# Register at https://www.google.com/recaptcha/admin (choose reCAPTCHA v3).
# NEXT_PUBLIC_ prefix exposes the site key to the browser; keep the secret private.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum score (0.0–1.0) to accept a submission. Default 0.5. Lower = more lenient.
RECAPTCHA_MIN_SCORE=0.5
